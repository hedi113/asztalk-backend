{
  "openapi": "3.1.1",
  "info": {
    "title": "Solution.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:5000"
    },
    {
      "url": "http://localhost:5001"
    }
  ],
  "paths": {
    "/api/create/character": {
      "post": {
        "tags": [
          "Character"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/delete/{id}": {
      "delete": {
        "tags": [
          "Character"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/characters": {
      "get": {
        "tags": [
          "Character"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/character/{id}": {
      "get": {
        "tags": [
          "Character"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/update/{id}": {
      "put": {
        "tags": [
          "Character"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CharacterUpdateModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CharacterUpdateModel": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "orderType": {
            "$ref": "#/components/schemas/OrderTypeEnum"
          },
          "species": {
            "type": "string"
          },
          "homeworld": {
            "type": "string"
          },
          "era": {
            "$ref": "#/components/schemas/EraEnum"
          },
          "rank": {
            "$ref": "#/components/schemas/RankEnum"
          },
          "lightSaberColor": {
            "type": "string"
          },
          "master": {
            "type": "string"
          },
          "apprentice": {
            "type": "string"
          },
          "forceSpeciality": {
            "type": "string"
          },
          "isAlive": {
            "type": "boolean"
          }
        }
      },
      "EraEnum": {
        "type": "integer"
      },
      "OrderTypeEnum": {
        "type": "integer"
      },
      "RankEnum": {
        "type": "integer"
      }
    }
  },
  "tags": [
    {
      "name": "Character"
    }
  ]
}